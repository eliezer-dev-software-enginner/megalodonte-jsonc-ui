{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Megalodonte JSONC UI v1",
  "description": "JSONC source is parsed into JSON before validation. Runtime also checks state types and action references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "states", "view"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "states": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/state" }
    },
    "view": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "size": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "initial"],
      "properties": {
        "type": { "enum": ["string", "boolean", "integer", "decimal"] },
        "initial": {}
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "string" } } }, "then": { "properties": { "initial": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "properties": { "initial": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "integer" } } }, "then": { "properties": { "initial": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 } } } },
        { "if": { "properties": { "type": { "const": "decimal" } } }, "then": { "properties": { "initial": { "type": "string", "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$" } } } }
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "bold": { "type": "boolean" },
        "textColor": { "type": "string" },
        "fontFamily": { "type": "string" },
        "bgColor": { "type": "string" }
      }
    },
    "layoutProps": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "spacing": { "$ref": "#/$defs/size" }, "padding": { "$ref": "#/$defs/size" },
        "width": { "$ref": "#/$defs/size" }, "height": { "$ref": "#/$defs/size" }, "maxWidth": { "$ref": "#/$defs/size" },
        "fillWidth": { "type": "boolean" }, "fillHeight": { "type": "boolean" },
        "alignment": { "enum": ["start", "center", "end"] }, "bgColor": { "type": "string" }
      }
    },
    "containerProps": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "spacing": { "$ref": "#/$defs/size" }, "padding": { "$ref": "#/$defs/size" },
        "width": { "$ref": "#/$defs/size" }, "height": { "$ref": "#/$defs/size" }, "maxWidth": { "$ref": "#/$defs/size" },
        "fillWidth": { "type": "boolean" }, "fillHeight": { "type": "boolean" },
        "alignment": { "enum": ["start", "center", "end"] }, "bgColor": { "type": "string" }, "bgImage": { "type": "string" }
      }
    },
    "textProps": {
      "type": "object", "additionalProperties": false,
      "properties": { "text": { "type": "string" }, "wrapWidth": { "$ref": "#/$defs/size" } }
    },
    "inputProps": {
      "type": "object", "additionalProperties": false,
      "properties": { "placeholder": { "type": "string" }, "height": { "$ref": "#/$defs/size" }, "width": { "$ref": "#/$defs/size" } }
    },
    "textAreaProps": {
      "type": "object", "additionalProperties": false,
      "properties": { "placeholder": { "type": "string" }, "height": { "$ref": "#/$defs/size" }, "width": { "$ref": "#/$defs/size" }, "readOnly": { "type": "boolean" } }
    },
    "mediaProps": {"type": "object", "additionalProperties": false, "properties": {"width": {"$ref": "#/$defs/size"}, "height": {"$ref": "#/$defs/size"}}},
    "imageProps": {"type": "object", "additionalProperties": false, "properties": {"source": {"type": "string"}, "width": {"$ref": "#/$defs/size"}, "height": {"$ref": "#/$defs/size"}}},
    "desktopProps": {"type":"object","additionalProperties":false,"properties":{"width":{"$ref":"#/$defs/size"},"height":{"$ref":"#/$defs/size"},"fillWidth":{"type":"boolean"},"fillHeight":{"type":"boolean"}}},
    "tableProps": {"type":"object","additionalProperties":false,"required":["columns"],"properties":{"columns":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["title","field"],"properties":{"title":{"type":"string"},"field":{"$ref":"#/$defs/identifier"}}}},"height":{"$ref":"#/$defs/size"},"pageSize":{"type":"integer","minimum":1},"horizontalScroll":{"type":"boolean"},"multipleSelection":{"type":"boolean"}}},
    "chartProps": {"type":"object","additionalProperties":false,"properties":{"title":{"type":"string"},"width":{"$ref":"#/$defs/size"},"height":{"$ref":"#/$defs/size"}}},
    "buttonProps": {
      "type": "object", "additionalProperties": false,
      "properties": { "text": { "type": "string" }, "height": { "$ref": "#/$defs/size" }, "fillWidth": { "type": "boolean" }, "defaultButton": { "type": "boolean" }, "iconSource": { "type": "string" }, "iconSize": { "$ref": "#/$defs/size" } }
    },
    "bind": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/identifier" }, "text": { "$ref": "#/$defs/identifier" },
        "visible": { "$ref": "#/$defs/identifier" }, "disabled": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/identifier" }, "items": { "$ref": "#/$defs/identifier" }, "selected": { "$ref": "#/$defs/identifier" }, "selectedItems": { "$ref": "#/$defs/identifier" }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" }, "email": { "type": "boolean" },
        "minLength": { "$ref": "#/$defs/size" }, "maxLength": { "$ref": "#/$defs/size" }, "label": { "type": "string" }
      }
    },
    "format": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "pattern"],
          "properties": {
            "kind": { "const": "mask" }, "pattern": { "type": "string", "pattern": "^[# .()/+\\-]*#[# .()/+\\-]*$" }, "store": { "const": "digits" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "currency"],
          "properties": { "kind": { "const": "currency" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "locale": { "type": "string" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "const": "number" }, "locale": { "type": "string" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "enum": ["uppercase", "lowercase"] } }
        }
      ]
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["Column", "Row", "Container", "Text", "Input", "PasswordInput", "DatePicker", "Button", "TextArea", "Select", "Image", "ImagePreview", "ImageSequence", "SoundSequence", "Scroll", "DataList", "DiffView", "Table", "BarChart", "PieChart", "Slot"] },
        "id": { "$ref": "#/$defs/identifier" }, "props": { "type": "object" },
        "style": { "$ref": "#/$defs/style" }, "bind": { "$ref": "#/$defs/bind" },
        "format": { "$ref": "#/$defs/format" }, "validation": { "$ref": "#/$defs/validation" },
        "events": { "type": "object" }, "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      },
      "allOf": [
        {"if":{"properties":{"type":{"const":"DataList"}}},"then":{"required":["bind"],"properties":{"props":{"$ref":"#/$defs/desktopProps"},"style":{"maxProperties":0},"format":false,"validation":{"maxProperties":0},"bind":{"required":["items","selected"],"properties":{"value":false,"text":false}},"events":{"additionalProperties":false,"properties":{"onSelect":{"$ref":"#/$defs/identifier"}}}}}},
        {"if":{"properties":{"type":{"const":"DiffView"}}},"then":{"required":["bind"],"properties":{"props":{"$ref":"#/$defs/desktopProps"},"style":{"maxProperties":0},"format":false,"validation":{"maxProperties":0},"bind":{"required":["text"],"properties":{"value":false}},"events":{"maxProperties":0}}}},
        {"if":{"properties":{"type":{"const":"Table"}}},"then":{"required":["props","bind"],"properties":{"props":{"$ref":"#/$defs/tableProps"},"style":{"maxProperties":0},"format":false,"validation":{"maxProperties":0},"bind":{"required":["items","selected"],"properties":{"value":false,"text":false}},"events":{"additionalProperties":false,"properties":{"onSelect":{"$ref":"#/$defs/identifier"},"onDoubleClick":{"$ref":"#/$defs/identifier"}}}}}},
        {"if":{"properties":{"type":{"enum":["BarChart","PieChart"]}}},"then":{"required":["bind"],"properties":{"props":{"$ref":"#/$defs/chartProps"},"style":{"maxProperties":0},"format":false,"validation":{"maxProperties":0},"bind":{"required":["items"],"properties":{"value":false,"text":false,"selected":false}},"events":{"maxProperties":0}}}},
        {"if":{"properties":{"type":{"const":"Slot"}}},"then":{"required":["props"],"properties":{"props":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"$ref":"#/$defs/identifier"},"fillWidth":{"type":"boolean"},"fillHeight":{"type":"boolean"}}},"style":{"maxProperties":0},"format":false,"validation":{"maxProperties":0},"events":{"maxProperties":0}}}},
        {
          "if": { "properties": { "type": { "enum": ["Column", "Row", "Scroll"] } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/layoutProps" }, "style": { "maxProperties": 0 }, "format": false, "validation": { "maxProperties": 0 }, "events": { "maxProperties": 0 }, "bind": { "properties": { "value": false, "text": false } } } }
        },
        {"if": {"properties": {"type": {"not": {"enum": ["Column", "Row", "Container", "Scroll"]}}}}, "then": {"properties": {"children": false}}},
        {"if": {"properties": {"type": {"const": "Container"}}}, "then": {"properties": {"props": {"$ref": "#/$defs/containerProps"}, "style": {"maxProperties": 0}, "format": false, "validation": {"maxProperties": 0}, "events": {"maxProperties": 0}}}},
        {"if": {"properties": {"type": {"const": "Image"}}}, "then": {"anyOf": [{"required": ["props"], "properties": {"props": {"required": ["source"]}}}, {"required": ["bind"], "properties": {"bind": {"required": ["source"]}}}], "properties": {"props": {"$ref": "#/$defs/imageProps"}, "style": {"maxProperties": 0}, "format": false, "validation": {"maxProperties": 0}, "events": {"maxProperties": 0}}}},
        {
          "if": { "properties": { "type": { "const": "Text" } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/textProps" }, "validation": { "maxProperties": 0 }, "events": { "maxProperties": 0 }, "bind": { "properties": { "value": false } } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["Input", "PasswordInput"] } } },
          "then": { "required": ["bind"], "properties": { "props": { "$ref": "#/$defs/inputProps" }, "bind": { "required": ["value"], "properties": { "text": false } }, "events": { "additionalProperties": false, "properties": { "onEnter": { "$ref": "#/$defs/identifier" } } } } }
        },
        { "if": { "properties": { "type": { "const": "PasswordInput" } } }, "then": { "properties": { "format": false } } },
        {
          "if": { "properties": { "type": { "const": "Button" } } },
          "then": {
            "properties": { "props": { "$ref": "#/$defs/buttonProps" }, "format": false, "validation": { "maxProperties": 0 }, "bind": { "properties": { "value": false } }, "events": { "additionalProperties": false, "properties": { "onClick": { "$ref": "#/$defs/identifier" } } } },
            "anyOf": [ { "required": ["props"], "properties": { "props": { "required": ["text"] } } }, { "required": ["bind"], "properties": { "bind": { "required": ["text"] } } } ]
          }
        },
        {"if": {"properties": {"type": {"const": "TextArea"}}}, "then": {"required": ["bind"], "properties": {"props": {"$ref": "#/$defs/textAreaProps"}, "bind": {"required": ["value"]}, "format": false, "events": {"type": "object", "additionalProperties": false, "properties": {}}}}},
        {"if": {"properties": {"type": {"const": "Select"}}}, "then": {"required": ["bind"], "properties": {"props": {"$ref": "#/$defs/mediaProps"}, "bind": {"required": ["items", "value"]}, "format": false, "validation": {"maxProperties": 0}, "events": {"maxProperties": 0}}}},
        {"if": {"properties": {"type": {"const": "DatePicker"}}}, "then": {"required": ["bind"], "properties": {"props": {"$ref": "#/$defs/mediaProps"}, "bind": {"required": ["value"], "properties":{"items":false,"selected":false}}, "format": false, "events": {"maxProperties": 0}}}},
        {"if": {"properties": {"type": {"const": "ImagePreview"}}}, "then": {"required": ["bind"], "properties": {"props": {"$ref": "#/$defs/mediaProps"}, "bind": {"required": ["source"]}, "format": false, "events": {"type": "object", "additionalProperties": false, "properties": {}}}}},
        {"if": {"properties": {"type": {"enum": ["ImageSequence", "SoundSequence"]}}}, "then": {"required": ["bind"], "properties": {"props": {"$ref": "#/$defs/mediaProps"}, "bind": {"required": ["items", "selected"]}, "format": false, "events": {"type": "object", "additionalProperties": false, "properties": {"onSelect": {"$ref": "#/$defs/identifier"}}}}}},
        {"if": {"properties": {"type": {"not": {"enum": ["Image", "ImagePreview"]}}}}, "then": {"properties": {"bind": {"properties": {"source": false}}}}},
        {"if": {"properties": {"type": {"not": {"enum": ["ImageSequence", "SoundSequence", "DataList", "Select", "Table", "BarChart", "PieChart"]}}}}, "then": {"properties": {"bind": {"properties": {"items": false}}}}},
        {"if": {"properties": {"type": {"not": {"enum": ["ImageSequence", "SoundSequence", "DataList", "Table"]}}}}, "then": {"properties": {"bind": {"properties": {"selected": false}}}}},
        {"if": {"properties": {"type": {"not": {"const": "Table"}}}}, "then": {"properties": {"bind": {"properties": {"selectedItems": false}}}}},
        {"if": {"properties": {"type": {"not": {"const": "Button"}}}}, "then": {"properties": {"style": {"properties": {"bgColor": false}}}}},
        {"if": {"properties": {"type": {"const": "Scroll"}}}, "then": {"required": ["children"], "properties": {"children": {"minItems": 1, "maxItems": 1}, "props": {"type": "object", "additionalProperties": false, "properties": {"width": {"$ref": "#/$defs/size"}, "height": {"$ref": "#/$defs/size"}, "fillWidth": {"type": "boolean"}, "fillHeight": {"type": "boolean"}}}}}}
      ]
    }
  }
}
